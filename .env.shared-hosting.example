APP_NAME="Donasi Latee"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://donasi.annuqayahlatee.id/backend_donasi

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Konfigurasi Database MySQL cPanel Shared Hosting
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_cpanel_db
DB_USERNAME=nama_cpanel_user
DB_PASSWORD=password_db_anda

# Shared Hosting: Gunakan file atau database, queue disetel sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
